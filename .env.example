# Docker Compose environment variables
POSTGRES_USER=avenquis
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_DB=avenquis_db

PORT=3000
NODE_ENV=development

# Required in production; use a secret manager and values of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-a-different-random-secret-at-least-32-characters
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Optional provider CA bundle. Production always verifies the database certificate.
DATABASE_SSL_CA=
# Optional outside production; production requires a securely injected Ed25519 key pair.
SIGNING_PRIVATE_KEY=
SIGNING_PUBLIC_KEY=
SIGNING_KEY_ID=avenquis-ed25519-v1
