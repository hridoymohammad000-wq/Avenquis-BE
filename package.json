{
  "name": "avenquis-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.11.0",
  "scripts": {
    "dev": "pnpm --filter api dev",
    "build": "pnpm -r build",
    "start": "node apps/api/dist/index.js",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "pnpm -r test",
    "verify": "pnpm verify:env && pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "verify:env": "node scripts/verify-env.js",
    "verify:full": "pnpm verify && pnpm tsx scripts/integration-tests.ts && node scripts/failure-cases.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.5.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.11.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.3.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "approvedBuilds": [
      "esbuild",
      "@google/genai",
      "protobufjs"
    ]
  }
}
